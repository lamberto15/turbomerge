{
  "name": "turbomerge",
  "version": "0.1.1",
  "description": "Mail merge for Word .docx files (MERGEFIELD, IF, NEXT, NEXTIF, SKIPIF, tables, multi-record templates) without Microsoft Word. A Node.js port of the Python docx-mailmerge2 library.",
  "keywords": [
    "docx-mailmerge",
    "docx",
    "mailmerge",
    "mail-merge",
    "word",
    "office",
    "openxml",
    "mergefield",
    "template"
  ],
  "license": "MIT",
  "author": "Lamby",
  "contributors": [
    "Bouke Haarsma (original Python docx-mailmerge)",
    "Iulian Ciorăscu (Python docx-mailmerge2)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "parity": "node scripts/parity.ts",
    "prepublishOnly": "pnpm run verify",
    "bench": "node scripts/bench.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "^24.0.0",
    "fflate": "^0.8.2",
    "publint": "0.3.25",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lamberto15/turbomerge.git"
  },
  "homepage": "https://github.com/lamberto15/turbomerge#readme",
  "bugs": {
    "url": "https://github.com/lamberto15/turbomerge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
